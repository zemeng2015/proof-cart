{
  "name": "proof-cart",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=24.14.1 <25", "npm": ">=11.11.0 <12" },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "setup": "npm ci --no-audit",
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "demo:fixture": "node scripts/demo-fixture.mjs",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:runtime": "node --test tests/runtime/server.test.mjs"
  },
  "dependencies": {
    "@shopify/hydrogen": "2026.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.58.2",
    "@react-router/dev": "7.18.3",
    "@shopify/mini-oxygen": "4.2.2",
    "@shopify/oxygen-workers-types": "4.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "@shopify/mini-oxygen": {
      "undici": "7.29.1",
      "body-parser": "1.20.6",
      "miniflare": {
        "undici": "6.28.1",
        "ws": "8.21.3",
        "youch": {"cookie": "0.7.2"}
      }
    },
    "@shopify/hydrogen": {
      "react-router": "$react-router",
      "@react-router/dev": "$@react-router/dev"
    }
  }
}
